# Pulse runs with NO environment variables. Fork, deploy, done.
#
# OPTIONAL — cloud backup (sign in, data follows you across devices) + the
# Claude connector. Add your OWN free Supabase project's two PUBLIC keys
# (both are safe in the browser — Row Level Security is what keeps your data
# private, not secrecy of these keys). From Supabase → Project Settings → API.
#   1. Create a free project at https://supabase.com
#   2. In its SQL editor run supabase/sync.sql (locks every row to the signed-in
#      account) and, for the connector, supabase/tiles.sql (tiles Claude builds
#      for you)
#   3. Authentication → Providers → Email: ON. Turn OFF "Confirm email" so
#      signing up signs you straight in (no email step)
#   4. Set these in Vercel → Settings → Environment Variables (and .env.local for
#      local dev), then redeploy
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL — the Claude connector password (app/api/mcp). Any long random string.
# Without it the connector is disabled (returns 503). Never commit the real value.
MCP_TOKEN=

# OPTIONAL — required only if you set MCP_TOKEN above. The connector has no
# signed-in browser session to borrow an identity from, so it talks to Supabase
# with the SERVICE ROLE key (see the Supabase block above) and has to be told
# which account its tiles belong to. This is your own user uuid:
# Supabase dashboard -> Authentication -> Users -> your row -> UID.
# Without it every connector tool returns a message naming what's missing.
OWNER_USER_ID=

# OPTIONAL — the AI board builder (app/api/personalize, docs/PLAN.md Stage 5).
# Claude Sonnet 5.5 reads the first-visit interview and plans the board: which
# tiles show, their order, goals, weights, theme and wording. Billed to YOUR key
# (about 3 cents a build), so it needs the caps below too. Without any of them
# the built-in rule-based mapper builds the board instantly and for free, and
# the board says so in one line. Server-side only. Get a key at
# https://console.anthropic.com and set a monthly spend limit there as well.
ANTHROPIC_API_KEY=
# Required with the key: run supabase/ai_usage.sql (the caps table) and set
# SUPABASE_SERVICE_ROLE_KEY. This salt hashes visitor IPs before they are
# stored (no raw IP is ever kept). Any random string, 32+ characters:
# openssl rand -base64 36
AI_USAGE_SALT=
# Optional limits (defaults 3 and 50). The OWNER_USER_ID account is not capped.
AI_BUILDS_PER_IP_PER_DAY=
AI_BUILDS_PER_DAY=

# OPTIONAL — live-data keys. Each user adds their OWN free key — NEVER share one
# (a shared key hits its quota and gets revoked for everyone at once). TikTok
# needs NO key (keyless). Set these in .env.local for local dev and in Vercel
# → Environment Variables when live; they stay server-side and never reach the
# browser. Without them, YouTube/stock tiles just show "add a key" and manual
# entry still works.
#   YouTube subscribers → console.cloud.google.com → enable "YouTube Data API v3" → create API key
YOUTUBE_API_KEY=
#   Stock prices → https://finnhub.io → free signup → copy API key
FINNHUB_API_KEY=

# ── Brand hourly counts ───────────────────────────────────────────────────────
# app/api/brand/collect looks up the accounts on the Brand tile every hour. Run
# scripts/set-x-token.ps1: it writes both values here and to Vercel production,
# and copies supabase/brand.sql with its Vault secrets to the clipboard.
#   X → console.x.com → create an app, add credit, generate a Bearer token. Pay-per-use.
X_BEARER_TOKEN=
# Any long random string; Supabase's hourly job sends it as the bearer token.
BRAND_CRON_SECRET=

# ── Walks / STEGA ingest ──────────────────────────────────────────────────────
# The Walks tile is fed by a SEPARATE app (STEGA), not logged on this board.
# app/api/walks/route.ts stores the log in a Vercel Blob and guards POST with a
# bearer token compared in constant time.
#
# WALKS_TOKEN — the shared secret STEGA sends as `Authorization: Bearer <token>`.
# Any long random string; STEGA holds the matching value as PULSE_WALKS_TOKEN.
# Without it the POST endpoint returns 503 and walks silently never arrive.
WALKS_TOKEN=
#
# BLOB_READ_WRITE_TOKEN — Vercel Blob storage credential (store `stega-walks`).
# Vercel injects this automatically once a Blob store is linked to the project;
# set it manually only for local dev. Vercel → Storage → your Blob store.
BLOB_READ_WRITE_TOKEN=

# ── WHOOP (optional — only if you connect a WHOOP band) ──────────────────────
# Register an app at developer-dashboard.whoop.com. Scopes: offline,
# read:recovery, read:cycles, read:sleep, read:workout, read:profile,
# read:body_measurement. `offline` is required or WHOOP issues no refresh
# token and the connection dies within the hour.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# One per environment; must match a redirect URI registered on the WHOOP app
# byte for byte. Locally that is http://localhost:3005/api/whoop/callback
WHOOP_REDIRECT_URI=
# Signs the OAuth `state` round trip so the callback cannot be forged. Not a
# WHOOP value — generate your own: openssl rand -base64 48
WHOOP_STATE_SECRET=
